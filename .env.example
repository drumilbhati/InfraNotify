# -----------------------------------------------------------------------------
# PulseBoard Environment Variables (Example)
# Copy this file to .env and replace the values with your actual configuration.
# -----------------------------------------------------------------------------

# ==========================================
# Relational Database (PostgreSQL)
# ==========================================
# These variables are required by the docker-compose.yml to set up the 
# database and connect the workspace to it. Used primarily by auth-service.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pulseboard
POSTGRES_USER=
POSTGRES_PASSWORD=

# ==========================================
# Document Database (MongoDB)
# ==========================================
# Used by metrics-ingestion-service and alert-engine-service for raw metric events
# and alert history logs.
MONGODB_URI=mongodb://mongodb:27017/pulsemongo
MONGODB_USER=
MONGODB_PASSWORD=

# ==========================================
# Cache & Rate Limiting (Redis)
# ==========================================
# Used by API gateway for rate limiting and alert-engine-service for state tracking.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# Messaging (Apache Kafka)
# ==========================================
# Used for high-throughput async messaging between metrics, alerts, and notification services.
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=pulseboard
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ==========================================
# Security (JWT)
# ==========================================
# Used by auth-service to issue tokens and api-gateway to validate them.
JWT_SECRET=your_super_secret_jwt_key_here_min_256_bits
JWT_EXPIRATION_MS=900000

# ==========================================
# Security (OAuth2 - Google)
# ==========================================
# OAuth2 client credentials for Google sign-in integration.
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret

# ==========================================
# Mail (Notification Service)
# ==========================================
# SMTP configuration used by the Node.js notification-service to send email alerts.
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mail_username
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@pulseboard.local

# ==========================================
# Observability
# ==========================================
# Distributed tracing (Jaeger/OpenTelemetry) and metrics (Prometheus/Grafana) endpoints.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
PROMETHEUS_ENDPOINT=/actuator/prometheus
GRAFANA_ADMIN_PASSWORD=
